# Base de datos (SQLite en desarrollo)
DATABASE_URL="file:./dev.db"

# Clave para cifrar las API keys de los apoderados (AES-256-GCM): 32 bytes en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o se cambia, las llaves ya guardadas dejan de poder descifrarse.
APP_ENCRYPTION_KEY=

# Secreto para firmar las sesiones (JWT): al menos 16 caracteres.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: modelo que usa cada proveedor (los nombres cambian con el tiempo)
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-6-luna   (por defecto; gpt-5+ y serie o no reciben temperatura)
# ANTHROPIC_MODEL=claude-sonnet-4-5
